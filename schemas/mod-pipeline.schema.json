{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/radaeli-mc-mods/mc-ci/v1/schemas/mod-pipeline.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "displayName",
    "java",
    "checks",
    "curseforge",
    "targets"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]+$"
    },
    "java": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          17,
          21,
          25
        ]
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_:.-]+$"
      }
    },
    "curseforge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "releaseType"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "releaseType": {
          "enum": [
            "auto",
            "alpha",
            "beta",
            "release"
          ]
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "task",
          "files",
          "loaders",
          "gameVersions",
          "java",
          "dependencies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "task": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_:.-]+$"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\r\\n]+$"
            },
            "minItems": 1
          },
          "loaders": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\r\\n]+$"
            },
            "minItems": 1
          },
          "gameVersions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\r\\n]+$"
            },
            "minItems": 1
          },
          "java": {
            "enum": [
              17,
              21,
              25
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\r\\n]+$"
            },
            "minItems": 0
          }
        }
      }
    }
  }
}
